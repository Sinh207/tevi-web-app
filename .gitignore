# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright writes both on every run of `pnpm test:e2e` — traces, screenshots and the HTML
# report. They are per-run artefacts of a local failure, not source.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors — JetBrains is per-developer; VS Code is not, so the shared files are
# named back in rather than the directory being blanket-ignored.
/.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# claude code — `settings.json` and `agents/` are the team's and belong in the repo;
# `settings.local.json` is one developer's permission grants.
.claude/settings.local.json
