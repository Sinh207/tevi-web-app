# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright writes both on every run of `pnpm test:e2e` — traces, screenshots and the HTML
# report. They are per-run artefacts of a local failure, not source.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The ffmpeg.wasm core, copied out of node_modules by `scripts/copy-ffmpeg-core.mjs` in front of
# `dev` and `build`. 24 MB of WebAssembly whose version is already pinned by the lockfile — that
# script's header explains why this one generated artefact is not committed like the others.
/public/ffmpeg/
