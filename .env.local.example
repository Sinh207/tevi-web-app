# Copy to `.env.local` and fill in. Values come from the legacy app's deploy workflow,
# `../tevi-web-app/.github/workflows/build-and-push.yml` — job `build-staging` for local
# dev, `build-production` for prod. Keys are declared in `shared/config/env.ts`; adding a
# value here without declaring it there does nothing (Next inlines only referenced keys).
#
# The legacy names are unprefixed because that app read them at *runtime* from Docker ENV.
# Here they are build-time inlined, so every browser-visible value needs NEXT_PUBLIC_.
# Renames: SIGN_REQUEST_SECRET_DATA → NEXT_PUBLIC_SIGN_SECRET,
#          FIREBASE_M_SENDER_ID     → NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID.

# ── Public (client) — inlined into the browser bundle ──────────────────────
# legacy: ENV / BASE_URL / W_API_DOMAIN / DOORMAN_DOMAIN / STATIC_DOMAIN
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_URL=https://tevi.dev
NEXT_PUBLIC_W_API_DOMAIN=https://wapi.tevi.dev
NEXT_PUBLIC_DOORMAN_DOMAIN=https://doorman.tevi.dev
NEXT_PUBLIC_STATIC_DOMAIN=https://static.tevi.dev

# Client-side HMAC signing (public secret — matches legacy app posture)
# legacy: SIGN_REQUEST_SECRET_DATA
NEXT_PUBLIC_SIGN_SECRET=

# Firebase web config (anonymous session only; project tevi-app-stg / -prod)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# OAuth client IDs (public). Only Google is wired up in Phase 1; the rest are declared
# so the deploy args and env schema stay in step with the legacy workflow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=
NEXT_PUBLIC_LINE_CHANNEL_ID=
NEXT_PUBLIC_TELEGRAM_BOT_ID=
# Locally point this at the dev server, not the deployed origin.
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:4000/login

# Analytics (optional, consent-gated)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://nebula.tevi.dev
NEXT_PUBLIC_GTM_ID=

# Mini apps (optional). Which origins may be framed by the mini-app player, as CSP
# `frame-src` source expressions, space- or comma-separated. Unset means `https:` — a
# creator's mini-app URL comes from the backoffice and points at whatever host its
# publisher uses, so there is no list to write ahead of time. Set it in an environment
# whose mini-app hosts are known and curated. See `shared/config/csp.ts`.
NEXT_PUBLIC_MINIAPP_FRAME_ORIGINS=

# ── Later phases ───────────────────────────────────────────────────────────
# The legacy workflow also ships FIREBASE_VAP_ID_KEY (web push), THUMBOR_* (image proxy),
# AGORA_APP_ID / BYTEPLUS_* / MUX_PUBLIC_ENV_KEY (live), CODA_PAYMENT_URL (payments) and
# ADD_TO_HOME_SCREEN. Add each to `shared/config/env.ts` with the feature that reads it.
#
# ── Server-only secrets (NEVER prefix NEXT_PUBLIC_) ────────────────────────
# MYSQL_*, REDIS_*, EMAIL_API_KEY, ZENDESK_*, DD_* — none are needed while the app
# talks only to W_API.
