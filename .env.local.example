# ── Public (client) — inlined into the browser bundle ──────────────────────
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_URL=https://tevi.dev
NEXT_PUBLIC_W_API_DOMAIN=https://wapi.tevi.dev
NEXT_PUBLIC_DOORMAN_DOMAIN=https://doorman.tevi.dev
NEXT_PUBLIC_STATIC_DOMAIN=https://static.tevi.dev

# Client-side HMAC signing (public secret — matches legacy app posture)
NEXT_PUBLIC_SIGN_SECRET=

# Firebase web config (Anonymous + Twitter auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# OAuth client IDs (public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=
NEXT_PUBLIC_LINE_CHANNEL_ID=
NEXT_PUBLIC_TELEGRAM_BOT_ID=
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://tevi.dev/login

# Analytics (optional, consent-gated)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GTM_ID=

# ── Server-only secrets (NEVER prefix NEXT_PUBLIC_) — Phase sau ─────────────
# MYSQL_HOST=
# REDIS_HOST=
# EMAIL_API_KEY=
