{
    "name": "tevi-web-app-ai",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "icons": "node scripts/generate-icon-names.mjs && node scripts/build-icon-sprite.mjs",
        "brand": "node scripts/generate-brand-assets.mjs",
        "dev": "node scripts/build-icon-sprite.mjs && next dev",
        "build": "node scripts/build-icon-sprite.mjs && next build --webpack",
        "start": "next start",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "lint:rtl": "bash scripts/check-rtl-classes.sh",
        "format": "biome format --write",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fingerprintjs/fingerprintjs": "^5.2.0",
        "@hookform/resolvers": "^5.4.0",
        "@sumsub/websdk": "^2.8.0",
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "^12.16.0",
        "i18next": "^26.3.6",
        "input-otp": "^1.4.2",
        "js-cookie": "^3.0.8",
        "jwt-decode": "^4.0.0",
        "mitt": "^3.0.1",
        "next": "16.2.10",
        "next-themes": "^0.4.6",
        "qrcode.react": "^4.2.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.81.0",
        "react-i18next": "^17.0.9",
        "server-only": "^0.0.1",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
