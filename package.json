{
    "name": "tevi-web-app-ai",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "icons": "node scripts/generate-icon-names.mjs && node scripts/build-icon-sprite.mjs",
        "brand": "node scripts/generate-brand-assets.mjs",
        "fonts": "node scripts/build-fonts.mjs",
        "dev": "node scripts/build-icon-sprite.mjs && node scripts/dev-cache.mjs --preflight && next dev --port 4000",
        "build": "node scripts/build-icon-sprite.mjs && next build --webpack",
        "start": "next start",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "lint:rtl": "bash scripts/check-rtl-classes.sh",
        "lint:testids": "node scripts/check-testids.mjs && node scripts/build-testid-catalog.mjs --check",
        "testids": "node scripts/build-testid-catalog.mjs",
        "format": "biome format --write",
        "typecheck": "tsc --noEmit",
        "cache": "node scripts/dev-cache.mjs",
        "cache:clean": "node scripts/dev-cache.mjs --clean",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "art": "pnpm art:cdn && pnpm art:gift-code && pnpm art:star-transfer",
        "art:audit": "node scripts/audit-cdn-art.mjs",
        "art:cdn": "node scripts/build-cdn-art.mjs",
        "art:gift-code": "node scripts/build-gift-code-art.mjs",
        "art:payment": "node scripts/build-payment-art.mjs",
        "art:star-transfer": "node scripts/build-star-transfer-art.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fingerprintjs/fingerprintjs": "^5.2.0",
        "@hookform/resolvers": "^5.4.0",
        "@stripe/react-stripe-js": "^6.8.1",
        "@stripe/stripe-js": "^9.13.0",
        "@sumsub/websdk": "^2.8.0",
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-react": "^8.6.0",
        "firebase": "^12.16.0",
        "i18next": "^26.3.6",
        "js-cookie": "^3.0.8",
        "jspdf": "^4.2.1",
        "lottie-web": "^5.13.0",
        "mitt": "^3.0.1",
        "next": "16.2.10",
        "next-themes": "^0.4.6",
        "react": "19.2.4",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.81.0",
        "react-i18next": "^17.0.9",
        "react-svg-credit-card-payment-icons": "^6.0.4",
        "server-only": "^0.0.1",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10",
        "wawoff2": "^2.0.1"
    }
}
